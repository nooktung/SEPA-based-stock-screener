{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "src.main",
        "start",
        "--no-browser"
      ],
      "port": 8765
    },
    {
      "name": "dashboard-view",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "src.main",
        "start",
        "--no-update",
        "--no-browser"
      ],
      "port": 8765
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8780",
        "--bind",
        "127.0.0.1",
        "--directory",
        "data/site"
      ],
      "port": 8780
    },
    {
      "name": "site-cloudflare-local",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd cloudflare && npx --yes wrangler pages dev ../data/site --port 8788 --ip 127.0.0.1 --kv MYLIST"
      ],
      "port": 8788
    }
  ]
}