# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Without keys the system runs on fixtures only: `doctor` says so, and nothing is publishable.

# --- DNSE OpenAPI (required): prices, index, reference prices, foreign flow ---
# Create the key pair at developers.dnse.com.vn / EntradeX. The secret is shown once.
# This system only reads market data; order endpoints are blocked in dnse_provider.py.
DNSE_API_KEY=
DNSE_API_SECRET=

# --- SSI FastConnect Data (optional): cross-check only, never the primary source ---
# Create on iBoard -> "Dịch vụ API" (needs a fixed IP registered there). Only the
# ConsumerID and ConsumerSecret go here. NEVER put SSI's PrivateKey anywhere: it signs orders.
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=

# --- Cloudflare (optional): the read-only web copy and "Danh sách của tôi" on it (run.md 7) ---
# Token permissions: Account > Cloudflare Pages > Edit, Account > Workers KV Storage > Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_MYLIST_ID=

# --- Database (optional) ---
# Default is SQLite at data/agent.db. Only SQLite is wired.
# DATABASE_URL=sqlite:///data/agent.db
